{
    "name": "bratiask/silverstripe-autotranslate",
    "type": "silverstripe-vendormodule",
    "authors": [
        {
            "name": "Pavol Tuka",
            "email": "pavol@bratia.sk"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6",
        "silverstripe/siteconfig": "^6",
        "tractorcow/silverstripe-fluent": "^8"
    },
    "autoload": {
        "psr-4": {
            "Bratiask\\Autotranslate\\": "src/"
        }
    },
    "extra": {
        "expose": [
            "client"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Bratiask\\Autotranslate\\Tests\\": "tests/"
        }
    }
}
